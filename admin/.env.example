# Leave blank on Vercel so /api uses the same-origin proxy in vercel.json.
# Set this only when intentionally connecting to a different API origin.
VITE_API_URL=
# Only needed if customer payment pages are built into this admin bundle.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
VITE_RAZORPAY_MOCK_MODE=false
