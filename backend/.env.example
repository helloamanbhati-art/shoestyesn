PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
# Separate production frontend/API hosts require none + true.
# Local HTTP development can use lax + false.
AUTH_COOKIE_SAME_SITE=none
AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_ACCESS_TTL_MS=900000
AUTH_REFRESH_TTL_MS=2592000000
ADMIN_ACCESS_TTL_MS=900000
ADMIN_REFRESH_TTL_MS=2592000000

# This is the only email allowed to authenticate as an administrator.
ADMIN_EMAIL=owner@gujjusstylehub.com
# Use at least 12 characters. Changing it and restarting revokes active admin sessions.
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_1DP5MM47F8wC1j
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MOCK_MODE=false

# Clerk server credentials (never expose the secret key to the browser)
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM_ADDRESS=noreply@harishcloths.com

# Frontend URL
FRONTEND_URL=https://your-storefront-host.example
ADMIN_URL=https://your-admin-host.example
ALLOWED_ORIGINS=https://your-storefront-host.example,https://your-admin-host.example
